# Copy this file to .env and fill in local developer values.
# Do not commit .env.

# Path to this CodexHome checkout.
CODEX_HOME=/path/to/CodexHome

# Optional default root for external project checkouts.
PROJECTS_ROOT=/path/to/projects

# Optional rclone target for locally encrypted incident evidence.
# Use a dedicated corporate Shared Drive folder, not a personal My Drive folder.
INCIDENT_EVIDENCE_RCLONE_DESTINATION=remote-name:path/to/incident-evidence

# Local keyring labels only. Private age identities are stored in the operating
# system credential store and must never be written to this file.
INCIDENT_EVIDENCE_PRIMARY_KEY_LABEL=codexhome-primary
INCIDENT_EVIDENCE_ESCROW_KEY_LABEL=codexhome-escrow
